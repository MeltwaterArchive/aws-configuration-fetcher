{
  "name": "@meltwater/aws-configuration-fetcher",
  "version": "2.0.1",
  "description": "A simple system for fetching configuration from both SSM and Secrets Manager in AWS",
  "type": "module",
  "main": "index.js",
  "module": "lib/index.js",
  "sideEffects": false,
  "keywords": [
    "node"
  ],
  "homepage": "https://github.com/meltwater/aws-configuration-fetcher",
  "bugs": "https://github.com/meltwater/aws-configuration-fetcher/issues",
  "repository": "meltwater/aws-configuration-fetcher",
  "license": "MIT",
  "author": {
    "name": "Team Jackalope",
    "email": "jackalope@meltwater.com"
  },
  "files": [
    "yarn.lock",
    "index.js",
    "lib",
    "docs"
  ],
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "pretest": "npm-run-all lint",
    "test:update": "NODE_OPTIONS='--experimental-vm-modules' jest --updateSnapshot",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "lint": "eslint --ignore-path .gitignore --ext .js .",
    "preversion": "npm-run-all test",
    "postversion": "git push && git push --tags",
    "pretty": "prettier --ignore-path .gitignore --write '**/*.(js|json|graphql|md)'",
    "format": "npm-run-all --serial pretty format:*",
    "format:ts": "eslint --ignore-path .gitignore --fix --ext .js ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "resolutions": {
    "ajv": "6.15.0",
    "ansi-regex": "5.0.1",
    "cross-spawn": "7.0.6",
    "debug": "4.3.7",
    "flatted": "3.4.2",
    "glob-parent": "5.1.2",
    "hosted-git-info": "2.8.9",
    "json5": "2.2.3",
    "lodash": "4.18.1",
    "minimist": "1.2.8",
    "path-parse": "1.0.7",
    "semver": "7.8.5",
    "shell-quote": "1.10.0",
    "word-wrap": "1.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.900.0",
    "@aws-sdk/client-ssm": "^3.900.0",
    "aws-xray-sdk-core": "^3.10.0",
    "cache-manager": "^3.6.3"
  },
  "devDependencies": {
    "eslint": "^7.4.0",
    "eslint-config-standard": "^16.0.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-node": "^11.0.0",
    "eslint-plugin-promise": "^4.2.1",
    "jest": "^30.0.0",
    "npm-run-all": "^4.1.2",
    "prettier": "^2.0.2",
    "testdouble": "^3.20.0"
  }
}
